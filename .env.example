# =====================================================================
# Example environment file for the ConnectStudio webcast E2E suite.
# Copy this to `.env` (which is git-ignored) and fill in real values:
#     cp .env.example .env
# Run with:  pytest -v --env=dev|prod --html=report.html --self-contained-html
# =====================================================================

# --- DEV admin login (default; used unless --env=prod) ---
URL=https://connectstudio-admin-dev.example.com
EMAIL=your-dev-user@example.com
PASSWORD=your-dev-password

# Org account used by test_00_cleanup / login (falls back to URL/EMAIL/PASSWORD
# above if these are omitted).
URL_ORG=https://connectstudio-admin-dev.example.com
EMAIL_ORG=your-dev-org-user@example.com
PASSWORD_ORG=your-dev-org-password

# --- PROD admin login (used with --env=prod) ---
URL_PROD=https://connectstudio-admin.example.com
EMAIL_PROD=your-prod-user@example.com
PASSWORD_PROD=your-prod-password

# Optional prod org overrides (fall back to URL_PROD/EMAIL_PROD/PASSWORD_PROD).
# URL_ORG_PROD=
# EMAIL_ORG_PROD=
# PASSWORD_ORG_PROD=

# --- WebDriver ---
# Optional explicit chromedriver path. Leave commented to let Selenium Manager
# resolve the driver automatically.
# DRIVER=C:/path/to/chromedriver-win64/chromedriver.exe

# --- Misc identifiers (replace with your own; not required for the core flow) ---
Tenant_ID=00000000-0000-0000-0000-000000000000
Token_ID=00000000-0000-0000-0000-000000000000

# --- Portal under test ---
# The portal (on the dashboard) that holds the sessions.
TARGET_PORTAL=General Information

# --- Webcast titles (one per type the suite creates) ---
NEW_WEBCAST_TITLE_1=Automated Webcast VxS - 001
NEW_WEBCAST_TITLE_2=Automated Webcast AxS - 002
NEW_WEBCAST_TITLE_3=Automated Webcast V - 003
NEW_WEBCAST_TITLE_4=Automated Webcast A - 004
NEW_WEBCAST_TITLE_5=Automated Webcast AxE - 005

# --- Webcast types ---
# These MUST match the exact option labels in the 'Webcast details' type
# dropdown. Valid options: "Video & slides (default)", "Video only",
# "Audio & slides", "Audio only".  (There is no distinct "AxE" type — AxE
# uses "Audio only".)
WEBCAST_TYPE_VxS=Video & slides (default)
WEBCAST_TYPE_AxS=Audio & slides
WEBCAST_TYPE_V=Video only
WEBCAST_TYPE_A=Audio only
WEBCAST_TYPE_AxE=Audio only

# --- Content file paths (absolute paths to local test assets) ---
# slide=PDF, video=MP4, headshot=JPG/PNG, audio=M4A
slide_path=C:/path/to/Test_Slides/AutomationSlide.pdf
video_path=C:/path/to/Test_Videos/sample-video.mp4
headshot_path=C:/path/to/Test_Photos/sample-headshot.jpg
audio_path=C:/path/to/Test_Audio/sample-audio.m4a
